# CropShift Backend Configuration

# Database connection URL (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cropshift

# Port for the FastAPI API server
API_PORT=8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Base public HTTPS URL for Exotel IVR webhooks (e.g. ngrok or production domain)
IVR_BASE_URL=https://YOUR-PUBLIC-HTTPS-DOMAIN

